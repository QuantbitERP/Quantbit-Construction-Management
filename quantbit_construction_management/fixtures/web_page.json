  "main_section_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>01 · Quality Management Dashboard</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --lime: #7ab800;\n    --lime-light: #eef6d6;\n    --bg: #f4f6f9;\n    --surface: #ffffff;\n    --card: #ffffff;\n    --card2: #f4f6f9;\n    --text: #1a1d23;\n    --muted: #6b7280;\n    --border: #e2e6ea;\n    --red: #dc2626;\n    --red-light: #fee2e2;\n    --amber: #d97706;\n    --amber-light: #fef3c7;\n    --green: #16a34a;\n    --green-light: #dcfce7;\n    --blue: #2563eb;\n    --blue-light: #dbeafe;\n  }\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n  html { font-size: 14px; }\n  body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; min-height: 100vh; display: flex; }\n\n  /* SIDEBAR */\n  .sidebar {\n    width: 220px; min-height: 100vh; background: var(--surface);\n    border-right: 1px solid var(--border); display: flex; flex-direction: column;\n    position: fixed; top: 0; left: 0; z-index: 100; box-shadow: 2px 0 8px rgba(0,0,0,.04);\n  }\n  .sidebar-logo { padding: 24px 20px 20px; border-bottom: 1px solid var(--border); }\n  .sidebar-logo .tag { font-size: 10px; letter-spacing: 3px; color: var(--lime); text-transform: uppercase; font-weight: 600; }\n  .sidebar-logo .name { font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 700; color: var(--text); margin-top: 4px; }\n  .nav { padding: 16px 0; flex: 1; }\n  .nav-section { padding: 8px 20px 4px; font-size: 10px; letter-spacing: 2px; color: var(--muted); text-transform: uppercase; }\n  .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; color: var(--muted); cursor: pointer; border-left: 3px solid transparent; transition: all .15s; font-size: 13px; }\n  .nav-item:hover { color: var(--text); background: var(--lime-light); }\n  .nav-item.active { color: var(--lime); border-left-color: var(--lime); background: var(--lime-light); font-weight: 600; }\n  .sidebar-footer { padding: 16px 20px; border-top: 1px solid var(--border); }\n  .user-chip { display: flex; align-items: center; gap: 10px; }\n  .avatar { width: 30px; height: 30px; border-radius: 50%; background: var(--lime); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #fff; }\n  .user-name { font-size: 12px; font-weight: 600; color: var(--text); }\n  .user-role { font-size: 10px; color: var(--muted); }\n\n  /* MAIN */\n  .main { margin-left: 220px; flex: 1; display: flex; flex-direction: column; min-height: 100vh; }\n  .topbar { height: 56px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 28px; position: sticky; top: 0; z-index: 50; box-shadow: 0 1px 4px rgba(0,0,0,.05); }\n  .page-tag { font-size: 10px; letter-spacing: 2px; color: var(--lime); text-transform: uppercase; font-weight: 600; }\n  .page-title { font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 600; color: var(--text); }\n  .topbar-right { display: flex; align-items: center; gap: 12px; }\n  .badge { background: var(--lime-light); color: var(--lime); border: 1px solid #c8e87a; border-radius: 20px; padding: 4px 12px; font-size: 11px; font-weight: 600; }\n  .btn { background: var(--lime); color: #fff; border: none; border-radius: 6px; padding: 8px 16px; font-size: 12px; font-weight: 700; cursor: pointer; }\n  .date-range { font-size: 12px; color: var(--muted); }\n\n  /* CONTENT */\n  .content { padding: 24px 28px; flex: 1; }\n  .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }\n  .kpi-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px; position: relative; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.04); }\n  .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--lime); }\n  .kpi-card.red::before { background: var(--red); }\n  .kpi-card.amber::before { background: var(--amber); }\n  .kpi-card.green::before { background: var(--green); }\n  .kpi-label { font-size: 11px; color: var(--muted); letter-spacing: .5px; text-transform: uppercase; margin-bottom: 8px; }\n  .kpi-value { font-family: 'Space Grotesk', sans-serif; font-size: 32px; font-weight: 700; color: var(--text); line-height: 1; }\n  .kpi-value span { font-size: 14px; font-weight: 400; color: var(--muted); margin-left: 2px; }\n  .kpi-trend { margin-top: 8px; font-size: 12px; display: flex; align-items: center; gap: 5px; }\n  .trend-up { color: var(--green); font-weight: 600; }\n  .trend-down { color: var(--red); font-weight: 600; }\n  .kpi-sub { color: var(--muted); }\n\n  .mid-row { display: grid; grid-template-columns: 1fr 1fr 340px; gap: 16px; margin-bottom: 20px; }\n  .chart-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.04); }\n  .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; }\n  .card-title { font-family: 'Space Grotesk', sans-serif; font-size: 14px; font-weight: 600; color: var(--text); }\n  .card-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }\n  .pill { background: var(--card2); border: 1px solid var(--border); border-radius: 20px; padding: 3px 10px; font-size: 11px; color: var(--muted); cursor: pointer; }\n  .pill.active { background: var(--lime-light); color: var(--lime); border-color: #c8e87a; font-weight: 600; }\n\n  /* BAR CHART */\n  .bar-chart { display: flex; align-items: flex-end; gap: 10px; height: 140px; padding-top: 10px; }\n  .bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; height: 100%; justify-content: flex-end; }\n  .bar { width: 100%; border-radius: 4px 4px 0 0; }\n  .bar-label { font-size: 10px; color: var(--muted); }\n  .bar-val { font-size: 10px; color: var(--text); font-weight: 600; }\n\n  /* DONUT */\n  .donut-wrap { display: flex; align-items: center; gap: 20px; }\n  .donut-legend { display: flex; flex-direction: column; gap: 10px; }\n  .legend-item { display: flex; align-items: center; gap: 8px; }\n  .legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }\n  .legend-name { font-size: 12px; color: var(--text); }\n  .legend-pct { font-size: 12px; color: var(--muted); margin-left: auto; font-weight: 600; }\n\n  /* GAUGE */\n  .gauge-wrap { text-align: center; }\n  .gauge-label { font-size: 11px; color: var(--muted); margin-top: 4px; }\n  .gauge-tiers { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }\n  .gauge-tier { background: var(--card2); border-radius: 6px; padding: 10px; text-align: center; border: 1px solid var(--border); }\n  .gauge-tier-val { font-family: 'Space Grotesk', sans-serif; font-size: 20px; font-weight: 700; }\n  .gauge-tier-label { font-size: 10px; color: var(--muted); margin-top: 2px; }\n\n  /* TABLE */\n  .bottom-row { display: grid; grid-template-columns: 1fr 380px; gap: 16px; }\n  table { width: 100%; border-collapse: collapse; }\n  th { font-size: 10px; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--border); }\n  td { padding: 11px 12px; border-bottom: 1px solid var(--border); font-size: 12px; color: var(--text); }\n  tr:last-child td { border-bottom: none; }\n  tr:hover td { background: var(--bg); }\n  .status-chip { border-radius: 4px; padding: 2px 8px; font-size: 10px; font-weight: 600; text-transform: uppercase; }\n  .s-open { background: var(--red-light); color: var(--red); }\n  .s-closed { background: var(--green-light); color: var(--green); }\n  .s-review { background: var(--amber-light); color: var(--amber); }\n  .severity { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }\n  .sev-crit { background: var(--red); }\n  .sev-high { background: var(--amber); }\n  .sev-med { background: var(--blue); }\n  .sev-low { background: var(--green); }\n</style>\n</head>\n<body>\n\n<aside class=\"sidebar\">\n  <div class=\"sidebar-logo\">\n    <div class=\"tag\">Module 01</div>\n    <div class=\"name\">QualityOps</div>\n  </div>\n  <nav class=\"nav\">\n    <div class=\"nav-section\">Overview</div>\n    <div class=\"nav-item active\"><span>◈</span> Dashboard</div>\n    <div class=\"nav-item\"><span>◷</span> Live Monitor</div>\n    <div class=\"nav-section\">Management</div>\n    <div class=\"nav-item\"><span>⊟</span> NCR Registry</div>\n    <div class=\"nav-item\"><span>⊕</span> CAPA Tracking</div>\n    <div class=\"nav-item\"><span>◫</span> Audit Schedule</div>\n    <div class=\"nav-item\"><span>⊞</span> Inspections</div>\n    <div class=\"nav-section\">Reports</div>\n    <div class=\"nav-item\"><span>↗</span> Analytics</div>\n    <div class=\"nav-item\"><span>⤓</span> Export</div>\n  </nav>\n  <div class=\"sidebar-footer\">\n    <div class=\"user-chip\">\n      <div class=\"avatar\">AK</div>\n      <div>\n        <div class=\"user-name\">Arjun Kumar</div>\n        <div class=\"user-role\">Quality Manager</div>\n      </div>\n    </div>\n  </div>\n</aside>\n\n<main class=\"main\">\n  <div class=\"topbar\">\n    <div>\n      <div class=\"page-tag\">01 · Quality Management</div>\n      <div class=\"page-title\">Dashboard Overview</div>\n    </div>\n    <div class=\"topbar-right\">\n      <span class=\"date-range\">Jul 2026 · Week 32</span>\n      <span class=\"badge\">● Live</span>\n      <button class=\"btn\">+ New NCR</button>\n    </div>\n  </div>\n\n  <div class=\"content\">\n    <!-- KPI ROW -->\n    <div class=\"kpi-row\">\n      <div class=\"kpi-card\">\n        <div class=\"kpi-label\">First Pass Yield</div>\n        <div class=\"kpi-value\">97.4<span>%</span></div>\n        <div class=\"kpi-trend\"><span class=\"trend-up\">↑ 1.2%</span><span class=\"kpi-sub\">vs last month</span></div>\n      </div>\n      <div class=\"kpi-card red\">\n        <div class=\"kpi-label\">Open NCRs</div>\n        <div class=\"kpi-value\">14</div>\n        <div class=\"kpi-trend\"><span class=\"trend-down\">↑ 3</span><span class=\"kpi-sub\">new this week</span></div>\n      </div>\n      <div class=\"kpi-card amber\">\n        <div class=\"kpi-label\">CAPA Overdue</div>\n        <div class=\"kpi-value\">6</div>\n        <div class=\"kpi-trend\"><span class=\"trend-down\">↑ 2</span><span class=\"kpi-sub\">pending review</span></div>\n      </div>\n      <div class=\"kpi-card green\">\n        <div class=\"kpi-label\">Audit Score</div>\n        <div class=\"kpi-value\">88<span>/ 100</span></div>\n        <div class=\"kpi-trend\"><span class=\"trend-up\">↑ 4 pts</span><span class=\"kpi-sub\">vs Q2</span></div>\n      </div>\n    </div>\n\n    <!-- MID ROW -->\n    <div class=\"mid-row\">\n      <!-- Bar Chart -->\n      <div class=\"chart-card\">\n        <div class=\"card-header\">\n          <div>\n            <div class=\"card-title\">Defects by Department</div>\n            <div class=\"card-sub\">Non-conformances raised · Aug 2026</div>\n          </div>\n          <div style=\"display:flex;gap:6px\">\n            <div class=\"pill active\">Monthly</div>\n            <div class=\"pill\">Quarterly</div>\n          </div>\n        </div>\n        <div class=\"bar-chart\">\n          <div class=\"bar-col\">\n            <div class=\"bar-val\">18</div>\n            <div class=\"bar\" style=\"height:65%;background:linear-gradient(180deg,#a8d520,#7ab800)\"></div>\n            <div class=\"bar-label\">Fab</div>\n          </div>\n          <div class=\"bar-col\">\n            <div class=\"bar-val\">11</div>\n            <div class=\"bar\" style=\"height:40%;background:#c8e87a\"></div>\n            <div class=\"bar-label\">Weld</div>\n          </div>\n          <div class=\"bar-col\">\n            <div class=\"bar-val\">24</div>\n            <div class=\"bar\" style=\"height:87%;background:linear-gradient(180deg,#dc2626,#b91c1c)\"></div>\n            <div class=\"bar-label\">Assembly</div>\n          </div>\n          <div class=\"bar-col\">\n            <div class=\"bar-val\">7</div>\n            <div class=\"bar\" style=\"height:26%;background:#c8e87a\"></div>\n            <div class=\"bar-label\">Paint</div>\n          </div>\n          <div class=\"bar-col\">\n            <div class=\"bar-val\">14</div>\n            <div class=\"bar\" style=\"height:52%;background:#fcd34d\"></div>\n            <div class=\"bar-label\">QC</div>\n          </div>\n          <div class=\"bar-col\">\n            <div class=\"bar-val\">9</div>\n            <div class=\"bar\" style=\"height:33%;background:#c8e87a\"></div>\n            <div class=\"bar-label\">Pack</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Donut -->\n      <div class=\"chart-card\">\n        <div class=\"card-header\">\n          <div>\n            <div class=\"card-title\">Defect Categories</div>\n            <div class=\"card-sub\">83 total non-conformances YTD</div>\n          </div>\n        </div>\n        <div class=\"donut-wrap\">\n          <svg width=\"130\" height=\"130\" viewBox=\"0 0 130 130\">\n            <circle cx=\"65\" cy=\"65\" r=\"52\" fill=\"none\" stroke=\"#e2e6ea\" stroke-width=\"18\"/>\n            <circle cx=\"65\" cy=\"65\" r=\"52\" fill=\"none\" stroke=\"#7ab800\" stroke-width=\"18\" stroke-dasharray=\"124 202\" stroke-dashoffset=\"0\" transform=\"rotate(-90 65 65)\"/>\n            <circle cx=\"65\" cy=\"65\" r=\"52\" fill=\"none\" stroke=\"#d97706\" stroke-width=\"18\" stroke-dasharray=\"88 238\" stroke-dashoffset=\"-124\" transform=\"rotate(-90 65 65)\"/>\n            <circle cx=\"65\" cy=\"65\" r=\"52\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"18\" stroke-dasharray=\"65 261\" stroke-dashoffset=\"-212\" transform=\"rotate(-90 65 65)\"/>\n            <circle cx=\"65\" cy=\"65\" r=\"52\" fill=\"none\" stroke=\"#dc2626\" stroke-width=\"18\" stroke-dasharray=\"49 277\" stroke-dashoffset=\"-277\" transform=\"rotate(-90 65 65)\"/>\n            <text x=\"65\" y=\"60\" text-anchor=\"middle\" fill=\"#1a1d23\" font-size=\"18\" font-family=\"Space Grotesk\" font-weight=\"700\">83</text>\n            <text x=\"65\" y=\"76\" text-anchor=\"middle\" fill=\"#6b7280\" font-size=\"10\" font-family=\"Inter\">NCRs</text>\n          </svg>\n          <div class=\"donut-legend\">\n            <div class=\"legend-item\"><div class=\"legend-dot\" style=\"background:#7ab800\"></div><span class=\"legend-name\">Dimensional</span><span class=\"legend-pct\">38%</span></div>\n            <div class=\"legend-item\"><div class=\"legend-dot\" style=\"background:#d97706\"></div><span class=\"legend-name\">Surface</span><span class=\"legend-pct\">27%</span></div>\n            <div class=\"legend-item\"><div class=\"legend-dot\" style=\"background:#2563eb\"></div><span class=\"legend-name\">Material</span><span class=\"legend-pct\">20%</span></div>\n            <div class=\"legend-item\"><div class=\"legend-dot\" style=\"background:#dc2626\"></div><span class=\"legend-name\">Other</span><span class=\"legend-pct\">15%</span></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- OQI Gauge -->\n      <div class=\"chart-card\">\n        <div class=\"card-header\">\n          <div>\n            <div class=\"card-title\">Overall Quality Index</div>\n            <div class=\"card-sub\">Composite KPI · Aug 2026</div>\n          </div>\n        </div>\n        <div class=\"gauge-wrap\">\n          <svg width=\"200\" height=\"120\" viewBox=\"0 0 200 120\">\n            <path d=\"M 20 110 A 80 80 0 0 1 180 110\" fill=\"none\" stroke=\"#e2e6ea\" stroke-width=\"16\" stroke-linecap=\"round\"/>\n            <path d=\"M 20 110 A 80 80 0 0 1 180 110\" fill=\"none\" stroke=\"#7ab800\" stroke-width=\"16\" stroke-linecap=\"round\" stroke-dasharray=\"251\" stroke-dashoffset=\"50\"/>\n            <text x=\"100\" y=\"95\" text-anchor=\"middle\" fill=\"#1a1d23\" font-size=\"28\" font-family=\"Space Grotesk\" font-weight=\"700\">82</text>\n            <text x=\"100\" y=\"112\" text-anchor=\"middle\" fill=\"#6b7280\" font-size=\"10\" font-family=\"Inter\">of 100</text>\n          </svg>\n          <div class=\"gauge-label\">Quality Performance Score</div>\n          <div class=\"gauge-tiers\">\n            <div class=\"gauge-tier\">\n              <div class=\"gauge-tier-val\" style=\"color:var(--green)\">97.4%</div>\n              <div class=\"gauge-tier-label\">FPY Rate</div>\n            </div>\n            <div class=\"gauge-tier\">\n              <div class=\"gauge-tier-val\" style=\"color:var(--amber)\">91%</div>\n              <div class=\"gauge-tier-label\">CAPA Close</div>\n            </div>\n            <div class=\"gauge-tier\">\n              <div class=\"gauge-tier-val\" style=\"color:var(--lime)\">88</div>\n              <div class=\"gauge-tier-label\">Audit Score</div>\n            </div>\n            <div class=\"gauge-tier\">\n              <div class=\"gauge-tier-val\" style=\"color:var(--red)\">14</div>\n              <div class=\"gauge-tier-label\">Open NCRs</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- BOTTOM ROW -->\n    <div class=\"bottom-row\">\n      <div class=\"chart-card\">\n        <div class=\"card-header\">\n          <div>\n            <div class=\"card-title\">Active Non-Conformance Reports</div>\n            <div class=\"card-sub\">Showing 6 of 14 open items</div>\n          </div>\n          <div class=\"pill\">View All →</div>\n        </div>\n        <table>\n          <thead>\n            <tr>\n              <th>NCR ID</th><th>Description</th>